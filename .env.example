# --- MySQL (Compose: serviço se chama `mysql`; use a mesma senha/banco dos vars abaixo) ---
# MYSQL_ROOT_PASSWORD=devroot
# MYSQL_DATABASE=banco_vendas
# MYSQL_USER=chatairag
# MYSQL_PASSWORD=chatairag_secret
# MYSQL_PORT=3306
#
# Com api + mysql no Docker Compose (recomendado):
# ZAP_DATABASE_URL=mysql+pymysql://chatairag:chatairag_secret@mysql:3306/banco_vendas
#
# API no Docker e MySQL só no Windows: host.docker.internal em vez de mysql
# API só no Windows (python src/main.py): localhost ou 127.0.0.1
ZAP_DATABASE_URL=

